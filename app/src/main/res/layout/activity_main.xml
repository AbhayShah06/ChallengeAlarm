<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#E8E8E8">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Challenge Alarm" android:textSize="26sp" android:textStyle="bold" android:textColor="#111111" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Starter reliability harness — schedules a test alarm one minute from now." />
    <Button android:id="@+id/schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Schedule 1-minute test" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="No test alarm scheduled." />
</LinearLayout>

