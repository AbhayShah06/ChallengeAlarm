<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp" android:background="#0D0E10">
    <TextView android:id="@+id/ringingTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="52dp" android:text="07:00" android:textSize="62sp" android:textStyle="bold" android:textColor="#F7F4EE" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALARM RINGING" android:letterSpacing="0.18" android:textSize="12sp" android:textStyle="bold" android:textColor="#FF8063" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/bg_card">
        <TextView android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A8A9AF" android:textStyle="bold" />
        <TextView android:id="@+id/problem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Solve: …" android:textSize="28sp" android:textStyle="bold" android:textColor="#F7F4EE" />
        <EditText android:id="@+id/answer" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="18dp" android:inputType="numberSigned" android:hint="Your answer" android:textSize="20sp" android:paddingHorizontal="18dp" android:textColor="#F7F4EE" android:textColorHint="#777A82" android:background="@drawable/bg_input" />
        <Button android:id="@+id/dismiss" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:text="Check answer" android:textColor="#101012" android:textSize="16sp" android:background="@drawable/bg_primary" />
        <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FF9B86" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="12dp" android:text="Complete the math to stop the alarm" android:textColor="#777A82" />
</LinearLayout>

